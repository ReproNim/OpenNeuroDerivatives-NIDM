fmriprep:csf_mean_3dgq0sk a nidm:PersonalDataElement,
        prov:Entity ;
    rdfs:label "csf mean" ;
    dct:description "Global signal: the average signal within anatomically-derived eroded CSF mask averaged over the run." ;
    nidm:isAbout term_ilx_0101997: ;
    nidm:sourceVariable "csf mean" .

