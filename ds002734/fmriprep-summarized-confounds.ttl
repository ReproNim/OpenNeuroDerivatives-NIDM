fmriprep:csf_mean_bivijs a nidm:PersonalDataElement,
        prov:Entity ;
    rdfs:label "csf mean" ;
    dct:description "Global signal: the average signal within anatomically-derived eroded CSF mask averaged over the run." ;
    nidm:isAbout term_ilx_0101997: ;
    nidm:sourceVariable "csf mean" .

fmriprep:csf_std_180b5kh a nidm:PersonalDataElement,
        prov:Entity ;
    rdfs:label "csf std" ;
    dct:description "Global signal: the average signal within anatomically-derived eroded CSF mask standard deviation over the run." ;
    nidm:isAbout term_ilx_0101997: ;
    nidm:sourceVariable "csf std" .

