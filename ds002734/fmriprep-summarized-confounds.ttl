        prov:Entity ;
    rdfs:label "framewise_displacement mean" ;
    dct:description "A quantification of the estimated bulk-head motion calculated using formula proposed by [Power2012] averaged over the run." ;
    nidm:isAbout term_ilx_0104909: ;
    nidm:sourceVariable "framewise_displacement mean" .

